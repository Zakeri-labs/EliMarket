# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin bootstrap (local script only — npm run setup-admin)
# Wrap in quotes if password contains # or spaces
ADMIN_PASSWORD="your-secure-admin-password"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console — "HTML tag" verification (content="..." value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Temporary fixed OTP (any phone) until real SMS is enabled.
# Works in local AND production while enabled. Set both to false when SMS is live.
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=213141
NEXT_PUBLIC_OTP_BYPASS_ENABLED=true
NEXT_PUBLIC_OTP_BYPASS_CODE=213141

# iSmart SMS (Infocomm Group, Oman) — HTTP POST Method API.
# Set OTP_BYPASS_ENABLED=false above once these are filled in and the
# server's IP has been whitelisted by Infocomm.
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_HEADER=            # 11-char sender ID registered with Infocomm
# SMS_API_URL=https://www.ismartsms.net/iBulkSMS/HttpWS/SMSDynamicRefIntlAPI.aspx
# Vercel has no fixed outbound IP, but Infocomm whitelists by IP (code 20).
# Route just this request through a forward proxy with a static IP instead:
# SMS_PROXY_URL=http://user:pass@proxy-host:port

# OpenAI (admin AI: product descriptions, vision catalog, image enhance)
# OPENAI_API_KEY=sk-...

# Optional alternative vision model (free tier) — used before OpenAI vision
# GEMINI_API_KEY=

# AI tuning (image generation on/off, provider, models, shots, prompt style)
# is NOT configured here — manage it in Dashboard → Settings.
# Only the API keys above stay in the environment.

# Oman online payments (Thawani). Optional — without keys, checkout uses a sandbox pay page.
# THAWANI_SECRET_KEY=
# THAWANI_PUBLISHABLE_KEY=
# THAWANI_MODE=sandbox

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://your-app.vercel.app
#   Redirect URLs (add BOTH):
#     https://your-app.vercel.app/**
#     http://localhost:3000/**
