# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin bootstrap (local script only — npm run setup-admin)
# Wrap in quotes if password contains # or spaces
ADMIN_PASSWORD="your-secure-admin-password"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console — "HTML tag" verification (content="..." value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Temporary fixed OTP (any phone) until real SMS is enabled.
# Works in local AND production while enabled. Set both to false when SMS is live.
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=213141
NEXT_PUBLIC_OTP_BYPASS_ENABLED=true
NEXT_PUBLIC_OTP_BYPASS_CODE=213141

# OpenAI (admin AI: product descriptions, vision catalog, image enhance)
# OPENAI_API_KEY=sk-...

# Optional alternative vision model (free tier) — used before OpenAI vision
# GEMINI_API_KEY=

# --- AI cost controls (see src/lib/ai/ai-config.ts) ---
# Paid AI studio shots are OFF by default: product photos still get the grey
# studio background + shadow from the free local sharp pipeline.
# Turn generation on only if you specifically want AI-rendered shots:
# AI_IMAGE_GENERATION_ENABLED=false
# AI_IMAGE_PROVIDER=gemini                  # gemini (keeps labels best, cheaper) | openai
# AI_IMAGE_MODEL=                           # blank = provider default
#                                           #   gemini -> gemini-2.5-flash-image
#                                           #   openai -> gpt-image-1-mini (or gpt-image-1)
# OPENAI_IMAGE_QUALITY=low                  # openai only: low | medium | high | auto
# AI_MAX_STUDIO_SHOTS=1                     # AI cover shots per source photo
# AI_MAX_CONTEXT_SHOTS=0                    # AI extra "contents" shots
# Gemini image backend needs GEMINI_API_KEY (same key as the vision draft).
# Paid OpenAI web image search is OFF by default:
# AI_WEB_IMAGE_SEARCH_ENABLED=false
# OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
# Text / vision drafting models (minis are already cents per product):
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# Every AI product image is forced to: light-grey studio backdrop + studio
# lighting + soft contact shadow + photoreal. Override one clause if needed:
# AI_IMAGE_STYLE_BACKGROUND=...
# AI_IMAGE_STYLE_LIGHTING=...
# AI_IMAGE_STYLE_SHADOW=...
# AI_IMAGE_STYLE_REALISM=...
# AI_IMAGE_STYLE_LABELS=...   # reproduce every label/brand/text exactly

# Oman online payments (Thawani). Optional — without keys, checkout uses a sandbox pay page.
# THAWANI_SECRET_KEY=
# THAWANI_PUBLISHABLE_KEY=
# THAWANI_MODE=sandbox

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://your-app.vercel.app
#   Redirect URLs (add BOTH):
#     https://your-app.vercel.app/**
#     http://localhost:3000/**
